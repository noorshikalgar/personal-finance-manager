// Personal Finance Tracker - Simple & Self-Hosted
// No accounting jargon - Just money in, money out, balance changes

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// AUTH - Single user only
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  pin           String?   // Optional PIN to hide amounts on dashboard
  currency      String    @default("INR") // User's preferred currency (INR or USD)
  
  // Theme preferences
  theme         String    @default("dark") // Theme preset: light, dark, violet, rose, blue, green, orange
  accentColor   String    @default("#8b5cf6") // Custom accent color for primary elements
  
  // Onboarding tracking
  onboardingCompleted Boolean @default(false) // Final completion flag
  onboardingCurrentStep Int @default(0) // 0=welcome, 1=add-account, 2=add-transaction, 3=add-category, 4=set-budget, 5=done
  onboardingCompletedActions String[] @default([]) // JSON array of completed action types
  onboardingSkipped Boolean @default(false) // User explicitly skipped the tour
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  transactions  Transaction[]
  categories    Category[]
  recurringTransactions RecurringTransaction[]
  goals         Goal[]
  reminders     Reminder[]
}

// ============================================================================
// ACCOUNTS - Two types: Bank/Salary and Credit Card
// ============================================================================

enum AccountType {
  BANK_SALARY
  CREDIT_CARD
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String
  type      AccountType
  
  // For BANK_SALARY accounts
  monthlyIncome     Decimal?  @db.Decimal(12, 2)
  currentBalance    Decimal   @db.Decimal(12, 2)
  startDate         DateTime?
  
  // For CREDIT_CARD accounts
  totalLimit        Decimal?  @db.Decimal(12, 2)
  availableLimit    Decimal?  @db.Decimal(12, 2)
  billingCycleStart Int?      // Day of month (1-31)
  dueDate           Int?      // Day of month (1-31)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  
  @@index([userId])
}

// ============================================================================
// CATEGORIES - Flat only, no nesting
// ============================================================================

model Category {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  monthlyBudget Decimal? @db.Decimal(12, 2) // Optional budget - visual only
  color         String?  // For UI visualization
  
  goalId        String?  // Optional link to a Goal
  goal          Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  reminders             Reminder[]
  
  @@unique([userId, name])
  @@index([userId])
}

// ============================================================================
// TRANSACTIONS - Keep it dead simple
// ============================================================================

enum TransactionType {
  INCOME
  EXPENSE
  ADJUSTMENT  // For system-generated balance adjustments
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  date        DateTime
  amount      Decimal         @db.Decimal(12, 2) // Positive for income, negative for expense
  type        TransactionType
  note        String?
  
  // Link to recurring transaction if auto-generated
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  
  // Link to reminder (optional)
  reminderId    String?
  reminder      Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
}

// ============================================================================
// RECURRING TRANSACTIONS - Monthly only, idempotent logic
// ============================================================================

model RecurringTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  amount      Decimal  @db.Decimal(12, 2) // Positive for income, negative for expense
  type        TransactionType
  note        String?
  
  // Monthly only
  dayOfMonth  Int      // 1-31
  startDate   DateTime
  endDate     DateTime? // Optional end date
  
  paused      Boolean  @default(false)
  lastRunAt   DateTime? // Last time transaction was created
  linkedToAccountIncome Boolean @default(false) // True if auto-created from account monthlyIncome
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  transactions Transaction[] // Generated transactions from this recurring rule
  
  @@index([userId])
  @@index([accountId])
  @@index([paused])
  @@index([lastRunAt])
}

// ============================================================================
// GOALS - Track financial objectives with progress
// ============================================================================

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum GoalCategory {
  SAVINGS
  DEBT_PAYOFF
  EMERGENCY_FUND
  INVESTMENT
  VACATION
  HOME
  EDUCATION
  CAR
  OTHER
}

model Goal {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title         String
  description   String?
  category      GoalCategory
  status        GoalStatus    @default(ACTIVE)
  
  targetAmount  Decimal       @db.Decimal(12, 2)  // How much to save/pay off
  currentAmount Decimal       @db.Decimal(12, 2)  @default(0) // How much saved so far
  
  deadline      DateTime?     // Target date to complete goal
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  completedAt   DateTime?     // When goal was completed
  
  categories    Category[]    // Categories linked to this goal
  
  @@index([userId])
  @@index([status])
  @@index([category])
}

// ============================================================================
// REMINDERS - Track recurring expenses and maintenance tasks
// ============================================================================

enum ReminderCycle {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum ReminderStatus {
  UPCOMING
  OVERDUE
  COMPLETED
  SNOOZED
}

model Reminder {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title           String
  description     String?
  
  // Link to Category (optional)
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  // Cycle configuration
  cycle           ReminderCycle
  customCycleDays Int?            // For CUSTOM cycle
  
  // Dates
  lastDate        DateTime?       // Last time this was completed
  nextDate        DateTime        // Next due date
  
  // Expense tracking
  isExpenseRelated Boolean        @default(false)
  estimatedCost    Decimal?       @db.Decimal(12, 2)
  
  // Status
  status          ReminderStatus  @default(UPCOMING)
  snoozedUntil    DateTime?       // If snoozed
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  transactions    Transaction[]   // Transactions linked to this reminder
  attachments     ReminderAttachment[]
  
  @@index([userId])
  @@index([status])
  @@index([nextDate])
  @@index([categoryId])
}

model ReminderAttachment {
  id              String    @id @default(cuid())
  reminderId      String
  reminder        Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  
  // File metadata
  fileName        String
  fileType        String    // MIME type: "image/jpeg", "application/pdf", etc.
  fileSize        Int       // Size in bytes
  
  // Storage info (provider-agnostic)
  storageProvider String    @default("local")  // 'local', 's3', 'wasabi', etc.
  storageKey      String    // UUID for local, S3 key for cloud
  
  uploadedAt      DateTime  @default(now())
  
  @@index([reminderId])
}
